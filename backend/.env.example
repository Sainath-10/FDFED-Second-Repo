# PostgreSQL (Docker mapped to host port 5432)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=fdfed_app
DB_PASSWORD=replace-with-a-local-password
DB_DATABASE=fdfed

# JWT
JWT_SECRET=nexus_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development

# Local mock payments: no gateway credentials or real charges.
PAYMENT_PROVIDER=mock

# Optional: only needed if PAYMENT_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Escrow lifecycle (mock mode)
AUTO_CANCEL_HOURS_BEFORE_START=0   # Prize pool funding deadline, in hours before start (0 = at start)
DRAFT_EXPIRY_HOURS=24              # Unpaid drafts expire after this many hours
MIN_ORGANIZER_TRUST_SCORE=50       # Organizers below this trust score cannot create competitions
DISPUTE_WINDOW_HOURS=24            # Players can dispute results this long after "End competition" before payouts
