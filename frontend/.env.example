# ── NEXUS ESPORTS frontend (React + Vite) ──────────────────────────────
# Base URL of the NestJS backend API used by the React app.
#
# The frontend fallback and backend default both use port 3000. Change this
# only when the API intentionally runs on another port.
#
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
VITE_API_URL=http://localhost:3000
