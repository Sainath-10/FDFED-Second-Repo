# ── NEXUS ESPORTS frontend (React + Vite) ──────────────────────────────
# Base URL of the NestJS backend API used by the React app.
#
# The legacy static client hardcoded http://localhost:3001, and that value is
# kept as the fallback when this variable is unset, so behaviour is unchanged.
# The backend's documented default is PORT=3000 (see backend/.env.example),
# so set this to whichever port your backend actually runs on.
#
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
VITE_API_URL=http://localhost:3001
