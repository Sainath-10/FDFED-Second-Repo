# ── NEXUS ESPORTS frontend (React + Vite) ──────────────────────────────
# Base URL of the NestJS backend API used by the React app.
#
# The frontend fallback and backend default both use port 3000. Change this
# only when the API intentionally runs on another port.
#
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
VITE_API_URL=http://localhost:3000

# Razorpay keys and webhook secrets belong ONLY in backend/.env.
# Checkout receives the public key ID from the authenticated order API.

# Mock payments are the backend default. No frontend payment keys are needed.
# Set PAYMENT_PROVIDER=mock in backend/.env to make that choice explicit.
